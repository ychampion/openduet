# From the repository root, with the provider's key in the environment:
#   bun run deploy/scripts/configure.ts [--provider name] [--model id] [--tailscale [--tailscale-hostname name]]
# or, for the scripted demonstration with no key:
#   bun run deploy/scripts/configure.ts --fake
# Or copy this file to deploy/.env and fill every required value.
COMPOSE_PROJECT_NAME=openduet

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Seals connection secrets and provider keys at rest. You hold it; losing it
# means re-entering every credential, which is the intended trade.
# Generate one with:  openssl rand -base64 32
OPENDUET_MASTER_KEY=

# Generate two independent values with: openssl rand -hex 32
# The API signs attempt capabilities; only the API holds the approval key.
OPENDUET_CAPABILITY_KEY=
OPENDUET_APPROVAL_KEY=

# Authenticates the warm runtime API. Real attempts get independent keys.
OPENDUET_RUNTIME_KEY=
# The group of the Docker socket; only openduet-cells, which holds the socket, gets it.
# Linux: stat -c %g /var/run/docker.sock
# Docker Desktop serves the socket from its VM, where its group is root (0);
# configure.ts measures it from a container.
DOCKER_GID=

# Postgres creates this user and database the first time it starts. configure.ts
# builds DATABASE_URL from them, so change them here before running it; by hand,
# keep DATABASE_URL naming the same user, password and database.
POSTGRES_USER=openduet
POSTGRES_PASSWORD=
POSTGRES_DB=openduet
DATABASE_URL=postgres://openduet:CHANGE_ME@postgres:5432/openduet
# Only database-roles is given DATABASE_URL. At each start it creates the roles
# openduet_migrate, openduet_api and openduet_effects with it, migrates, and hands the
# service addresses of its own. Where the database's administrator creates the
# roles instead, set all three, at the same server and database
# (docs/DEPLOYMENT.md, "Database roles"); otherwise leave them empty.
OPENDUET_MIGRATE_DATABASE_URL=
OPENDUET_API_DATABASE_URL=
OPENDUET_EFFECTS_DATABASE_URL=

# ---------------------------------------------------------------------------
# Images
#
# Empty: Compose builds the images from this checkout (up --build). Set a tag
# to pull the published images instead and never build here: main follows the
# main branch, a release tag such as v0.3.0 stays on that release, and a short
# commit pins one build. Update with bun run openduet deploy, which backs up the
# database before a release that migrates it.
# See docs/DEPLOYMENT.md, "Using prebuilt images".
# ---------------------------------------------------------------------------

OPENDUET_IMAGE_TAG=
# Where the images are pulled from. Empty: ghcr.io/ychampion.
OPENDUET_IMAGE_REGISTRY=

# ---------------------------------------------------------------------------
# Ports on the host
# ---------------------------------------------------------------------------

OPENDUET_PORT=3100
WEB_PORT=3101

# Memory caps, so one runaway service cannot take the machine. Empty uses the
# default shown; the runtime has its own 2g. Raise them on a larger machine.
# Apply a change with bun run openduet deploy, or recreate the service.
OPENDUET_MEMORY_LIMIT=
POSTGRES_MEMORY_LIMIT=
WEB_MEMORY_LIMIT=
OPENDUET_CELLS_MEMORY_LIMIT=
# Optional HTTPS origin when putting the loopback web service behind a proxy.
OPENDUET_WEB_ORIGIN=
# That proxy, so sign-in limits count each browser rather than the proxy:
# `gateway` when it runs on this host, or its address. Its X-Forwarded-For must
# hold one address, the browser's. docs/DEPLOYMENT.md, "Sign-in limits".
OPENDUET_WEB_TRUSTED_UPSTREAM=
# The web address sign-in links point at, for email sign-in (docs/CLIENT.md).
# An https:// address here also lets people text OpenDuet (docs/CONNECTORS.md).
OPENDUET_PUBLIC_URL=
# Set to false when an https:// OPENDUET_PUBLIC_URL is reachable only on a private
# network or tailnet, so MCP sign-in registers dynamically (docs/CONNECTORS.md).
OPENDUET_OAUTH_CLIENT_METADATA=
# What a person is told when a connection's tool needs an entitlement they
# have not been granted (docs/CONNECTORS.md, "Entitlements and identity"). Blank keeps the
# default: "Contact support to get your account verified."
OPENDUET_GATE_MESSAGE=
# Your Google OAuth client, for signing in to Gmail and Google Calendar. Both,
# or neither. Setup and publishing status: docs/mail-calendar.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Your GitHub OAuth app, for connecting GitHub from the app catalog. Both, or
# neither. Its callback is OPENDUET_PUBLIC_URL/api/oauth/callback (docs/CONNECTORS.md).
GITHUB_MCP_CLIENT_ID=
GITHUB_MCP_CLIENT_SECRET=
# A Composio project key, for signing in to Gmail, Google Calendar and Google
# Drive through Composio's own Google app, with no Google OAuth client of your
# own, and to connect other apps Composio signs in to (Slack, Notion, GitHub,
# ...). Optional auth configs per toolkit; left out, Composio's managed ones.
# COMPOSIO_AUTH_CONFIGS takes toolkit=ac_id pairs for any other app, comma
# separated. Setup: docs/mail-calendar.md and docs/CONNECTORS.md.
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_GOOGLECALENDAR=
COMPOSIO_AUTH_CONFIG_GOOGLEDRIVE=
COMPOSIO_AUTH_CONFIGS=
# The signing secret of the webhook you set in Composio to
# OPENDUET_PUBLIC_URL/api/composio/events. Set, Gmail and Google Calendar signed
# in through Composio are watched by its triggers; unset, read on a schedule.
COMPOSIO_WEBHOOK_SECRET=
# Limits on use through Composio, each per billing month. Every one is unset by
# default: no limit. Set them to your Composio plan's allowances to keep within
# them; past a limit, calls are refused before they reach Composio (an approved
# send included), triggers are switched off, or new sign-ins are refused, until
# the month resets. Docs: docs/CONNECTORS.md, "Limits on use through Composio".
OPENDUET_COMPOSIO_TOOL_CALLS_MONTHLY_CAP=
OPENDUET_COMPOSIO_TRIGGER_EVENTS_MONTHLY_CAP=
# The most accounts connected through Composio at once.
OPENDUET_COMPOSIO_ACCOUNTS_CAP=
# A monthly credit in US dollars that use past the limits above may spend, at
# the rates below (defaults: 0.0005 per tool call, 0.005 per trigger event).
# Unset, every limit is hard.
OPENDUET_COMPOSIO_MONTHLY_CREDIT_USD=
OPENDUET_COMPOSIO_TOOL_CALL_USD=
OPENDUET_COMPOSIO_TRIGGER_EVENT_USD=
# The day of the month (1-28, UTC) your Composio billing month starts. Default 1.
OPENDUET_COMPOSIO_BILLING_DAY=
# The older name for OPENDUET_COMPOSIO_TOOL_CALLS_MONTHLY_CAP, still read.
OPENDUET_MANAGED_CALLS_MONTHLY_CAP=
# Your Microsoft Entra app, for signing in to Outlook mail and calendar. Both,
# or neither. The tenant is common (personal and work accounts) unless you name
# yours. Setup: docs/mail-calendar.md.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=
# Web Push to phones and browsers (docs/DEPLOYMENT.md, "Phone notifications").
# configure.ts writes this installation's own key pair; no third-party service.
# Generate by hand with: bun run deploy/scripts/vapid-keys.ts
OPENDUET_VAPID_PUBLIC_KEY=
OPENDUET_VAPID_PRIVATE_KEY=
# Who push services contact about this installation. Empty: mailto: the owner.
OPENDUET_VAPID_SUBJECT=
# Push endpoints outside the browser push services, comma separated. Leave empty.
OPENDUET_PUSH_EXTRA_ORIGINS=
# OpenDuet notices meetings that move or overlap, deadlines at risk and messages
# still waiting on an answer, from the calendars and mailboxes people connect.
# false turns that off for this installation.
OPENDUET_DETECTORS=true

# When a deadline someone set is about to be missed and they haven't opened its
# push, OpenDuet texts and then calls the number they verified in Settings, once
# they agree to it there. Texts and calls come from this Twilio number. Set all
# three, with an https OPENDUET_PUBLIC_URL, and point the number's incoming
# messages at OPENDUET_PUBLIC_URL/api/reach/twilio/sms. A US number must be
# registered for A2P 10DLC (or be a verified toll-free number) before carriers
# deliver its texts. What a text and a call minute cost is counted toward each
# person's spend. docs/SITUATIONAL-AWARENESS.md, "Reaching your phone".
OPENDUET_TWILIO_ACCOUNT_SID=
OPENDUET_TWILIO_AUTH_TOKEN=
OPENDUET_TWILIO_FROM_NUMBER=
OPENDUET_REACH_TEXT_USD=
OPENDUET_REACH_CALL_USD_PER_MINUTE=
# Where verification codes may be texted, as calling-code prefixes (default +1:
# the US and Canada, without the Caribbean area codes, which need their own
# entry such as +1876), and how many codes the installation sends an hour
# (default 30). Set Twilio's Geo Permissions to match, against SMS pumping.
OPENDUET_REACH_CODE_PREFIXES=
OPENDUET_REACH_CODES_PER_HOUR=

# ---------------------------------------------------------------------------
# Tailscale
#
# Read only by deploy/docker-compose.tailscale.yml, which reaches the web client
# from your own devices over your tailnet with HTTPS and publishes no host port.
# See docs/DEPLOYMENT.md, "Tailscale".
#
# TS_AUTHKEY is an auth key from the Tailscale admin console, or an OAuth client
# secret with ?ephemeral=false. It is a secret: keep this file private.
#
# TS_HOSTNAME becomes the node name, so the address is
# https://<TS_HOSTNAME>.<your tailnet>.ts.net. Once the node has joined, run
# `bun run deploy/scripts/tailscale-origin.ts` to write OPENDUET_WEB_ORIGIN.
#
# TS_EXTRA_ARGS passes further flags to the node, for example
# --advertise-tags=tag:openduet, which an OAuth client secret requires.
# ---------------------------------------------------------------------------

TS_AUTHKEY=
TS_HOSTNAME=openduet
TS_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# Model providers
#
# OpenDuet is model-agnostic. Keys are injected by the gateway proxy and never
# reach the runtime container. The fake provider is a deterministic local
# deployment check, enabled only with configure.ts --fake.
#
# OPENDUET_DEFAULT_PROVIDER is one of exactly these names, and needs the key
# beside it:
#   fireworks          FIREWORKS_API_KEY
#   anthropic          ANTHROPIC_API_KEY
#   openai             OPENAI_API_KEY
#   google             GOOGLE_API_KEY
#   chatgpt            none: the owner signs in to ChatGPT through the sign-in
#                      routes (docs/DEPLOYMENT.md, "Signing in to a provider")
#   openai-compatible  OPENAI_COMPAT_BASE_URL, and OPENAI_COMPAT_API_KEY
#                      or the OPENAI_COMPAT_OAUTH_ settings below
# Any other name, or openai-compatible without a usable address, stops the
# service at start-up with a message naming the setting. An empty key for the
# selected provider is reported at start-up as a warning, and every model call
# is refused until it is set.
#
# OPENDUET_DEFAULT_MODEL is the identifier that provider serves, written exactly
# as its API expects it. Fireworks identifiers are full account paths.
# ---------------------------------------------------------------------------

OPENDUET_DEFAULT_PROVIDER=fireworks
OPENDUET_DEFAULT_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
# Whether that model reads images, so the agent sees its own screenshots as
# pictures: true or false. Left empty, OpenDuet's model catalog decides.
OPENDUET_DEFAULT_MODEL_VISION=
# Whether that model searches the web with its provider's own search tool:
# true or false. Left empty, OpenDuet's model catalog decides (Claude and recent
# OpenAI models do). false sends its searches to OpenDuet's own search instead.
OPENDUET_DEFAULT_MODEL_NATIVE_SEARCH=
# The output limit given to a model request that names none, and the engine's
# reply ceiling unless OPENDUET_ENGINE_MAX_OUTPUT_TOKENS overrides it. It is held
# against the job's output budget until the call settles, and never exceeds
# what the job has left.
OPENDUET_DEFAULT_MAX_OUTPUT_TOKENS=4096

# ---------------------------------------------------------------------------
# Web search
#
# Every agent can search the web with nothing set here: with its model's own
# search where the provider has one, and otherwise with a search that needs no
# key (DuckDuckGo, then Wikipedia). A search API key, when set, is used first.
# The owner turns web reads off per space in Settings. docs/CONNECTORS.md,
# "Web search".
#
# The keyless search reads DuckDuckGo's results page, which is meant for
# people, from this server's address. It is not an official API and its terms
# may not allow it; OpenDuet paces it (one request at a time, two seconds apart,
# repeated queries reused for ten minutes, a fifteen-minute pause after a robot
# check), but DuckDuckGo can still block the address. For a hosted or shared
# installation, set one of these keys.
#
# TAVILY_API_KEY is asked first when both are set: its results carry the
# passages of each page that match the query, and with it web.fetch also reads
# a public page that gave a direct read no text (a page built by scripts, or
# one behind a bot wall) through Tavily Extract, at most three pages a turn.
# Its free plan includes 1,000 credits a month; a search costs one, an
# extracted page at most two, and both count toward the spending limits below.
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

OPENDUET_ENABLE_FAKE_PROVIDER=false
OPENDUET_ENABLE_TEST_CONNECTOR=false

# Rooms, shared spaces, guests and hand-offs are a preview, off by default.
# docs/ROOMS.md, "Turning rooms on", says what true turns on.
OPENDUET_PREVIEW_MULTIPLAYER=false

# Turn whole features on or off with on or off; empty keeps the default, which
# is on for all but multiplayer (that one follows OPENDUET_PREVIEW_MULTIPLAYER).
# Off, the feature's routes are refused and the app leaves it out.
# docs/DEPLOYMENT.md, "Turn features on or off", lists what each covers.
OPENDUET_FEATURE_MULTIPLAYER=
OPENDUET_FEATURE_VOICE=
OPENDUET_FEATURE_PHONE=off
OPENDUET_FEATURE_SMS=off
OPENDUET_FEATURE_BROWSER=
OPENDUET_FEATURE_COMPUTER=
OPENDUET_FEATURE_COMPANIES=off

# Engine limits for each attempt; empty keeps the default. docs/DEPLOYMENT.md,
# "Engine limits", says what each one does.
#   OPENDUET_ENGINE_MAX_TURNS       iterations one run may take (default 150)
#   OPENDUET_ENGINE_MAX_OUTPUT_TOKENS reply ceiling; empty uses the default output limit above
#   OPENDUET_COMPACTION_MAX_TOKENS  conversation size that triggers a summary (default 200000)
#   OPENDUET_MODEL_CONTEXT_WINDOW   the served model's context window, when it is smaller
OPENDUET_ENGINE_MAX_TURNS=
OPENDUET_ENGINE_MAX_OUTPUT_TOKENS=
OPENDUET_COMPACTION_MAX_TOKENS=
OPENDUET_MODEL_CONTEXT_WINDOW=

# Automatic memory reads what people say in chat with this model; empty uses the
# default provider and model, and `off` keeps structured observations only.
# OPENDUET_MEMORY_DAILY_CALLS is how many reads one person's memory may make a day;
# empty means no daily limit.
OPENDUET_MEMORY_MODEL=
OPENDUET_MEMORY_PROVIDER=
OPENDUET_MEMORY_DAILY_CALLS=

# Semantic recall embeds memory with the default provider's embedding model
# (Fireworks, OpenAI or Google); with none, recall stays lexical. These name
# another model, `local` as the provider embeds on OPENDUET_LOCAL_MODEL_URL, and
# OPENDUET_EMBEDDING_MODEL=off turns it off. docs/DEPLOYMENT.md, "Semantic recall".
OPENDUET_EMBEDDING_PROVIDER=
OPENDUET_EMBEDDING_MODEL=
OPENDUET_EMBEDDING_DIMENSIONS=

# A model on your own machine or network, for private conversations and `local`
# embeddings: its OpenAI-compatible address, its model name and, if it needs
# one, its key. docs/PRIVACY-ROUTER.md.
OPENDUET_LOCAL_MODEL_URL=
OPENDUET_LOCAL_MODEL=
OPENDUET_LOCAL_MODEL_KEY=

# The company map reads mail with the default model; these name another model
# and provider for scans alone. OPENDUET_COMPANIES_DAILY_CALLS is how many model
# calls one person's scans may make in 24 hours; empty is no limit.
# docs/DEPLOYMENT.md, "Company map".
OPENDUET_COMPANIES_MODEL=
OPENDUET_COMPANIES_PROVIDER=
OPENDUET_COMPANIES_DAILY_CALLS=

# Auto-review asks this model whether a reversible action may go ahead without
# the person; empty uses the model chosen in the app (else the default provider
# and model), and `off` sends every such action to the person. A review longer
# than the timeout, or past the hourly limit for one space, also goes to the
# person.
OPENDUET_REVIEW_MODEL=
OPENDUET_REVIEW_PROVIDER=
OPENDUET_REVIEW_TIMEOUT_MS=12000
OPENDUET_REVIEW_HOURLY_LIMIT=60
# Undo send: seconds a message waits after it is cleared to go, while it can
# still be cancelled from its receipt (0 to 120; 0 sends at once).
OPENDUET_SEND_HOLD_SECONDS=20
# Work nobody is waiting on (a schedule, a timer, an event) that would reach
# someone outside OpenDuet goes ahead on its own from this confidence (0 to 1),
# built from what the person said before; below it, it is left as a suggestion.
OPENDUET_PROACTIVE_CONFIDENCE=0.6
# The level a chat app's message to others starts at, until the person picks one:
# when_confident (or confidence) sends it on the same score, draft drafts it unless
# the person or their routine said to send, draft_only also keeps it out of
# proactive work entirely, always sends it on its own.
OPENDUET_MESSAGES_TO_OTHERS=confidence

# Spending caps on model calls, in estimated US dollars and in tokens, for the
# whole installation and for each person, per UTC day and month. Empty is no
# limit. At OPENDUET_SPEND_NOTICE_PERCENT (default 80) the person sees a notice;
# at the limit new model calls are refused until it resets. OPENDUET_MODEL_PRICES
# replaces the built-in price estimates, as JSON per million tokens.
# docs/DEPLOYMENT.md, "Spending caps".
OPENDUET_SPEND_MONTHLY_USD=
OPENDUET_SPEND_DAILY_USD=
OPENDUET_SPEND_PERSON_MONTHLY_USD=
OPENDUET_SPEND_PERSON_DAILY_USD=
OPENDUET_SPEND_MONTHLY_TOKENS=
OPENDUET_SPEND_DAILY_TOKENS=
OPENDUET_SPEND_PERSON_MONTHLY_TOKENS=
OPENDUET_SPEND_PERSON_DAILY_TOKENS=
OPENDUET_SPEND_NOTICE_PERCENT=
OPENDUET_MODEL_PRICES=
# Each person's background model calls alone (watches, standing runs,
# routines, memory, learning). A person's own messages never count here and
# are never held back by them. Empty is no limit. docs/BACKGROUND-COMPUTE.md.
OPENDUET_SPEND_PERSON_BACKGROUND_MONTHLY_USD=
OPENDUET_SPEND_PERSON_BACKGROUND_DAILY_USD=
OPENDUET_SPEND_PERSON_BACKGROUND_MONTHLY_TOKENS=
OPENDUET_SPEND_PERSON_BACKGROUND_DAILY_TOKENS=
# true counts each job's model calls against its dollar limit, beside its actions.
OPENDUET_JOB_USD_COUNTS_MODELS=
# Standing work for people who stopped coming: the days a person may go
# unseen before their routines and watches rest (they come back on the next
# time the person is seen, without running the times they missed), and how
# many routines one person may keep. Empty is no rest and no limit.
# docs/DEPLOYMENT.md, "Hosting for other people".
OPENDUET_REST_ROUTINES_AFTER_DAYS=
OPENDUET_ROUTINES_PER_PERSON_MAX=
# How many pieces of long work (runs) one space may have going at once.
# Empty is no limit.
OPENDUET_RUNS_ACTIVE_PER_SPACE_MAX=

# Files sent in chat. The largest file in MB (default 20, at most 100) and the
# most files in one message (default 10, at most 100). Uploads per person are
# not limited by default; a hosted install can limit how many one person has
# under way at once and how many they may start in a window of minutes
# (default 10). docs/DEPLOYMENT.md, "Attachments".
OPENDUET_ATTACHMENT_MAX_MB=
OPENDUET_ATTACHMENTS_PER_MESSAGE=
OPENDUET_ATTACHMENT_UPLOADS_AT_ONCE=
OPENDUET_ATTACHMENT_UPLOADS_PER_WINDOW=
OPENDUET_ATTACHMENT_UPLOAD_WINDOW_MINUTES=
# Always on, for the service's own sake: uploads it holds in flight at once from
# everyone (default 16) and the MB they may hold between them (default 384).
# One person may hold at most half of each.
OPENDUET_ATTACHMENT_SERVER_UPLOADS=
OPENDUET_ATTACHMENT_SERVER_UPLOAD_MB=

# Model routing, each provider/model: a fast model for memory reads, voice
# asides, reviews and scans; a vision model for agent requests with pictures;
# fallbacks, comma-separated, for a provider that limits or fails. Reasoning
# effort per role: off, none, low, medium or high (defaults medium and low).
# docs/DEPLOYMENT.md, "Model routing".
OPENDUET_MODEL_FAST=
OPENDUET_MODEL_VISION=
OPENDUET_MODEL_FALLBACK=
OPENDUET_REASONING_EFFORT_AGENT=
OPENDUET_REASONING_EFFORT_SIDE=
# Milliseconds a chat turn may stay silent before the person is shown a one-line
# acknowledgement; 0 (the default) turns it off and makes no model call. On, the
# fast model (the default model when OPENDUET_MODEL_FAST is unset) writes the line
# as each chat turn starts: one short call per turn. docs/DEPLOYMENT.md.
OPENDUET_ACK_AFTER_MS=0

# Sorting new mail and calendar changes into needs you, for your information,
# or ignore, for Home's "Needs you" list: a provider/model, or off. Unset, it
# uses the owner's secondary model for scheduled work, else OPENDUET_MODEL_FAST,
# else the default. Its calls are background calls, held to the
# OPENDUET_SPEND_PERSON_BACKGROUND_* limits. How often it runs, in seconds
# (default 120). docs/SITUATIONAL-AWARENESS.md, "Sorting what came in".
OPENDUET_MODEL_TRIAGE=
OPENDUET_TRIAGE_INTERVAL_SECONDS=

# Alerts when the service is unhealthy: a webhook (JSON POST) and/or email via
# an SMTP server (smtps://user:password@host:465). OPENDUET_OPERATOR_TOKEN opens
# GET /health/detail. docs/DEPLOYMENT.md, "Alerts".
OPENDUET_ALERT_WEBHOOK_URL=
OPENDUET_ALERT_EMAIL_TO=
OPENDUET_ALERT_EMAIL_FROM=
OPENDUET_ALERT_SMTP_URL=
OPENDUET_ALERT_INTERVAL_SECONDS=
OPENDUET_ALERT_REPEAT_MINUTES=
# The disk check fails below this many MB free under the spaces, artifacts and
# work directories (default 2048; 0 turns it off).
OPENDUET_ALERT_DISK_MIN_FREE_MB=
OPENDUET_OPERATOR_TOKEN=
# Spending alerts, off unless set: the last hour above this many times the
# usual hour; one person above this percent of today's spending. Neither fires
# below OPENDUET_ALERT_SPEND_MIN_USD (default 1).
OPENDUET_ALERT_SPEND_HOURLY_MULTIPLE=
OPENDUET_ALERT_SPEND_PERSON_PERCENT=
OPENDUET_ALERT_SPEND_MIN_USD=
# Every problem report people send from the app is also POSTed here as JSON,
# for the people running the installation. docs/FEEDBACK.md.
OPENDUET_FEEDBACK_WEBHOOK_URL=

# Account mail: sign-in links and password reset links for every account, sent
# through this SMTP server (smtps://user:password@host:465) from this address.
# Unset, they go only to the owner, from the owner's own connected mailbox, and
# a forgotten password otherwise needs `bun run openduet account reset <email>`.
# Links need OPENDUET_PUBLIC_URL. docs/DEPLOYMENT.md, "Account mail".
OPENDUET_SMTP_URL=
OPENDUET_MAIL_FROM=

# What this installation calls itself (page titles, account mail) and what the
# assistant calls itself. Both are OpenDuet when empty; an empty assistant name
# takes the installation's name when that is set. OPENDUET_IDENTITY_FILE
# replaces the assistant's whole identity with a file of your own, a path inside
# the service container, held to the same short length. Icons, logo and colours
# come from a brand folder: docs/DEPLOYMENT.md, "Names and look".
OPENDUET_INSTANCE_NAME=
OPENDUET_ASSISTANT_NAME=
OPENDUET_IDENTITY_FILE=

# The digest of the one-time setup code `openduet init` printed. While it is set
# and no account exists, creating the first account needs that code, so a new
# installation belongs to whoever was given it rather than to its first
# visitor. `bun run openduet account setup-code` issues another.
# `openduet init` (deploy/scripts/configure.ts) and the installer fill this line
# in; leave it as it is. docs/DEPLOYMENT.md, "Claiming a new installation".
# OPENDUET_SETUP_CODE_HASH=
# With no setup code, an installation whose OPENDUET_PUBLIC_URL or
# OPENDUET_WEB_ORIGIN names another machine refuses its first account until
# `bun run openduet account setup-code` makes one. Set OPENDUET_SETUP_OPEN=true
# only if the first visitor should be allowed to create the owner without a
# code; set it back to false once your account exists.
# OPENDUET_SETUP_OPEN=

# Sign-in with your own identity provider: any OpenID Connect issuer, such as
# Google, Microsoft, Okta, Authentik or Keycloak. Register a client there whose
# redirect is <OPENDUET_PUBLIC_URL>/api/signin/oidc/callback and set all three.
# OPENDUET_OIDC_ACCOUNTS=create also makes an account at a person's first sign-in
# (the default, existing, signs in only accounts that exist here).
# OPENDUET_OIDC_EMAIL_LINK=no-password lets a verified email claim only accounts
# without a password; use it with a public provider such as Google.
# OPENDUET_OIDC_REQUIRE_CLAIM=name=value lets the provider decide who may enter.
# OPENDUET_PASSWORD_SIGNIN=off makes the provider the only way in.
# docs/DEPLOYMENT.md, "Sign-in with your identity provider".
# OPENDUET_OIDC_ISSUER=
# OPENDUET_OIDC_CLIENT_ID=
# OPENDUET_OIDC_CLIENT_SECRET=
# OPENDUET_OIDC_LABEL=
# OPENDUET_OIDC_SCOPES=
# OPENDUET_OIDC_ACCOUNTS=
# OPENDUET_OIDC_EMAIL_LINK=
# OPENDUET_OIDC_REQUIRE_CLAIM=
# OPENDUET_PASSWORD_SIGNIN=

FIREWORKS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# One OpenAI-compatible endpoint of your choosing, selected with
# OPENDUET_DEFAULT_PROVIDER=openai-compatible whatever software serves it.
# Give the version prefix, for example https://models.example.net/v1
#
# This is the only provider address that may be plain http://, for a model
# server on your own machine or network, for example http://192.168.1.20:11434/v1
# Over http:// the key and every prompt travel unencrypted, so keep it to a
# network you trust. Inside Compose, localhost is the OpenDuet container itself:
# use an address the container can reach.
#
# The gateway refuses a provider with an empty key. If your server checks no
# key, set OPENAI_COMPAT_API_KEY to any non-empty value. Left empty, an https://
# endpoint falls back to OPENAI_API_KEY; a plain http:// endpoint never
# receives OPENAI_API_KEY.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Addresses people set in the app (a model endpoint, an MCP server, a calendar
# or mail server) are resolved and checked on every connection. Only the
# installation's owner may name one on this machine or its network; anyone
# else's must be public. Cloud metadata (169.254.169.254 and the like) is
# refused to everyone; true opens it to the owner's own settings only.
OPENDUET_ALLOW_CLOUD_METADATA=false

# Internal hosts that rooms and everyone else may reach too, for a team's own
# MCP servers, calendars and mail. Comma-separated: host names
# (mcp.corp.internal), wildcards for the names below one (*.corp.internal) and
# address ranges (10.20.0.0/16, fd00:20::/32). A private address is reached
# only inside a listed range, so list the range your internal names answer in.
# A token goes over plain http:// only to a listed name or a listed range.
# Agents' computers reach listed ranges over HTTPS too. Never list the range
# OpenDuet's own containers use. Empty (the default) keeps everyone but the
# owner to public addresses. See docs/CONNECTORS.md.
OPENDUET_PRIVATE_HOSTS=

# The text-to-speech model, used when OPENAI_API_KEY or OPENAI_COMPAT_BASE_URL is
# set. Empty uses gpt-4o-mini-tts.
OPENDUET_SPEECH_MODEL=

# The OAuth client ChatGPT sign-in presents. Left empty, it is the Codex CLI's
# public client, the one OpenAI has registered for this sign-in.
OPENDUET_CHATGPT_CLIENT_ID=

# OAuth for the OpenAI-compatible endpoint, for a provider that issues access
# tokens rather than keys. Register OPENAI_COMPAT_OAUTH_REDIRECT_URL with the
# provider, give its issuer (or its authorize and token addresses), and the
# owner signs in from OpenDuet. The token is then used instead of
# OPENAI_COMPAT_API_KEY. Signing in needs OPENDUET_MASTER_KEY.
# OPENAI_COMPAT_OAUTH_LABEL names the provider on the sign-in button.
OPENAI_COMPAT_OAUTH_ISSUER=
OPENAI_COMPAT_OAUTH_AUTHORIZE_URL=
OPENAI_COMPAT_OAUTH_TOKEN_URL=
OPENAI_COMPAT_OAUTH_REVOKE_URL=
OPENAI_COMPAT_OAUTH_CLIENT_ID=
OPENAI_COMPAT_OAUTH_CLIENT_SECRET=
OPENAI_COMPAT_OAUTH_SCOPES=
OPENAI_COMPAT_OAUTH_REDIRECT_URL=
OPENAI_COMPAT_OAUTH_LABEL=

# ---------------------------------------------------------------------------
# Voice (docs/VOICE.md)
#
# An ElevenLabs key turns on speech, transcription, push-to-talk in chat and
# voice mode. Speech uses it in preference to OPENAI_API_KEY. The key stays in
# the service: voice mode hands the browser a single-use token instead.
# Voices and models left empty use the defaults docs/VOICE.md names.
# ---------------------------------------------------------------------------

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_SECOND_VOICE_ID=
ELEVENLABS_SPEECH_MODEL=
ELEVENLABS_STREAMING_MODEL=
ELEVENLABS_TRANSCRIPTION_MODEL=
# Optional caps on what one person may use in a day: seconds of voice messages
# transcribed, characters of replies read aloud, and voice conversations
# started (for example 1800, 20000 and 30). Empty: no cap.
OPENDUET_VOICE_DAILY_SECONDS=
OPENDUET_VOICE_DAILY_CHARACTERS=
OPENDUET_VOICE_DAILY_SESSIONS=
# Asides (short words with the agent while it works in voice mode) one person
# may have in a day. Empty is no limit; asides are still counted.
OPENDUET_VOICE_DAILY_ASIDES=
# Calls need the key above and an https:// OPENDUET_PUBLIC_URL ElevenLabs can reach.
# A speech engine is made at the first call unless one is named here (seng_...).
ELEVENLABS_SPEECH_ENGINE_ID=
# Minutes of calls one person may have in 30 days. Empty: no cap.
OPENDUET_CALL_MONTHLY_MINUTES=

# ---------------------------------------------------------------------------
# Storage (docs/DEPLOYMENT.md, Storage)
#
# Files the service keeps by their content are stored on the artifacts volume.
# To keep them in an S3-compatible bucket instead (AWS S3, Cloudflare R2,
# MinIO and the like), set OPENDUET_BLOB_STORE=s3, the bucket and its keys. The
# keys stay with the service and never reach an agent's computer.
#   OPENDUET_BLOB_S3_ENDPOINT   the service's address; empty is AWS for the region
#   OPENDUET_BLOB_S3_REGION     (us-east-1)
#   OPENDUET_BLOB_S3_PREFIX     keys go under it, so installations can share a bucket
# ---------------------------------------------------------------------------

OPENDUET_BLOB_STORE=
OPENDUET_BLOB_S3_ENDPOINT=
OPENDUET_BLOB_S3_BUCKET=
OPENDUET_BLOB_S3_REGION=
OPENDUET_BLOB_S3_PREFIX=
OPENDUET_BLOB_S3_ACCESS_KEY_ID=
OPENDUET_BLOB_S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Sandboxes
#
# Connect E2B, Modal, Daytona or Maritime in Settings, under Connections, Sandbox. The
# provider's key is entered there and sealed with OPENDUET_MASTER_KEY.
#
# Or give every agent a computer of its own on this host's Docker engine, with
# no account and no key: set OPENDUET_SANDBOX_PROVIDER=docker and build the image
# with --profile sandbox (docs/sandbox-docker.md).
#
# OPENDUET_SANDBOX_PROJECT labels the sandboxes this installation owns at the
# provider, so installations sharing one provider account never touch each
# other's. configure.ts writes a random one; keep it, since changing it
# orphans what the old value labelled. Lower-case letters, digits and hyphens.
#
# The rest are optional; empty uses the default in brackets.
#   OPENDUET_SANDBOX_LEASE_SECONDS                  idle time before a session ends (900)
#   OPENDUET_SANDBOX_MAX_CONCURRENT                 sandboxes running at once (4)
#   OPENDUET_SANDBOX_MAX_CONCURRENT_PER_CONNECTION  per connection (the ceiling above)
#   OPENDUET_SANDBOX_MAX_DISPLAYS                   chats and runs on one agent's computer at once (6)
#   OPENDUET_SANDBOX_WORKSPACE_RETENTION_SECONDS    how long a suspended workspace is kept (604800)
#   OPENDUET_SANDBOX_SNAPSHOT_TTL_SECONDS           provider snapshot lifetime, longer than retention (2592000)
#   OPENDUET_SANDBOX_ALLOW_PROXY_ENVIRONMENT        true to let Modal use this host's proxy settings (false)
#   OPENDUET_PROCESS_MAX_PER_COMPUTER               background processes per agent's computer (4)
#   OPENDUET_PROCESS_MAX_PER_SPACE                  background processes per space (8)
#   OPENDUET_PROCESS_DEFAULT_TTL_MINUTES            a process's time limit when none is given (120)
#   OPENDUET_PROCESS_MAX_TTL_MINUTES                the longest time limit a process may have (720)
#   OPENDUET_PROCESS_OUTPUT_MAX_BYTES               output a process keeps in the computer (8388608)
#   OPENDUET_SANDBOX_AWAKE_SECONDS_PER_DAY          time processes may keep a space's computers running per day (no limit)
#   OPENDUET_E2B_PLAN                               hobby or pro, as the E2B account is (hobby)
#   OPENDUET_MARITIME_MAX_COMPUTERS                 most computers kept at Maritime, asleep or awake (no cap)
#   OPENDUET_MARITIME_MAX_AWAKE                     most Maritime computers awake at once (no cap)
#   OPENDUET_SANDBOX_PROVIDER                       docker for a computer per agent on this engine (none)
#   OPENDUET_SANDBOX_DOCKER_IMAGE                   the image it starts from (openduet-sandbox:local)
#   OPENDUET_SANDBOX_DOCKER_CPUS                    CPUs one computer may use (1)
#   OPENDUET_SANDBOX_DOCKER_MEMORY_MB               its memory, with no swap beyond it (2048)
#   OPENDUET_SANDBOX_DOCKER_PIDS                    processes it may run at once (512)
#   OPENDUET_SANDBOX_DOCKER_DISK_MB                 what its files may hold, checked before each command (4096)
#   OPENDUET_SANDBOX_DOCKER_EGRESS                  open for public HTTPS sites, connected_hosts_only for the
#                                                 hosts listed below, deny_all for nothing (open)
#   OPENDUET_SANDBOX_DOCKER_IDLE_SECONDS            unused this long, it is stopped until used again (900)
#   OPENDUET_SANDBOX_EGRESS_PORT                    where the service's egress guard listens (8791)
#   OPENDUET_SANDBOX_EGRESS_EXTRA_HOSTS             the hosts connected_hosts_only reaches, comma-separated;
#                                                 .example.com covers the names below it (none)
#   OPENDUET_EGRESS_RECORD_DAYS                     days the record of where computers connected is kept (30)
#   OPENDUET_RETENTION_DAYS                         days model-call records and unused connector events are kept;
#                                                 35 or more, 90 when hosting for other people (kept for ever)
#   OPENDUET_OBSERVATION_RETENTION_DAYS             days an unused mail or calendar observation is kept (14)
#   OPENDUET_OBSERVATION_TOMBSTONE_DAYS             days an expired observation's delivery key is kept, no content (180)
#   OPENDUET_TRASH_DAYS                             days a deleted file stays in the trash, restorable (7)
#   OPENDUET_TRASH_MAX_MB                           most one conversation's trash holds; oldest goes first (1024)
#   OPENDUET_STORAGE_PER_PERSON_MB                  most one person keeps, saved and sent files together (no limit)
#   OPENDUET_EGRESS_HOLD_MAX_BYTES                  largest change from the command line held for approval (64 MiB)
#   OPENDUET_EGRESS_APPROVAL_HOLD_SECONDS           how long such a change waits inside its command for an answer (90)
# ---------------------------------------------------------------------------

OPENDUET_SANDBOX_PROJECT=
OPENDUET_SANDBOX_LEASE_SECONDS=
OPENDUET_SANDBOX_MAX_CONCURRENT=
OPENDUET_SANDBOX_MAX_CONCURRENT_PER_CONNECTION=
OPENDUET_SANDBOX_MAX_DISPLAYS=
OPENDUET_SANDBOX_WORKSPACE_RETENTION_SECONDS=
OPENDUET_SANDBOX_SNAPSHOT_TTL_SECONDS=
OPENDUET_SANDBOX_ALLOW_PROXY_ENVIRONMENT=
OPENDUET_PROCESS_MAX_PER_COMPUTER=
OPENDUET_PROCESS_MAX_PER_SPACE=
OPENDUET_PROCESS_DEFAULT_TTL_MINUTES=
OPENDUET_PROCESS_MAX_TTL_MINUTES=
OPENDUET_PROCESS_OUTPUT_MAX_BYTES=
OPENDUET_SANDBOX_AWAKE_SECONDS_PER_DAY=
OPENDUET_E2B_PLAN=
OPENDUET_MARITIME_MAX_COMPUTERS=
OPENDUET_MARITIME_MAX_AWAKE=
OPENDUET_SANDBOX_PROVIDER=
OPENDUET_SANDBOX_DOCKER_IMAGE=
OPENDUET_SANDBOX_DOCKER_CPUS=
OPENDUET_SANDBOX_DOCKER_MEMORY_MB=
OPENDUET_SANDBOX_DOCKER_PIDS=
OPENDUET_SANDBOX_DOCKER_DISK_MB=
OPENDUET_SANDBOX_DOCKER_EGRESS=
OPENDUET_SANDBOX_DOCKER_IDLE_SECONDS=
OPENDUET_SANDBOX_EGRESS_PORT=
OPENDUET_SANDBOX_EGRESS_EXTRA_HOSTS=
OPENDUET_EGRESS_RECORD_DAYS=
OPENDUET_RETENTION_DAYS=
OPENDUET_OBSERVATION_RETENTION_DAYS=
OPENDUET_OBSERVATION_TOMBSTONE_DAYS=
OPENDUET_TRASH_DAYS=
OPENDUET_TRASH_MAX_MB=
OPENDUET_STORAGE_PER_PERSON_MB=
OPENDUET_EGRESS_HOLD_MAX_BYTES=
OPENDUET_EGRESS_APPROVAL_HOLD_SECONDS=

# ---------------------------------------------------------------------------
# Plugins and attempts
#
# Optional; empty uses the default in brackets. docs/DEPLOYMENT.md, "Isolation
# and image provenance".
#   OPENDUET_MCP_NODE_IMAGE            the image npx plugins run in (node:22-alpine, pinned)
#   OPENDUET_MCP_PYTHON_IMAGE          the image uvx plugins run in (uv python3.12-alpine, pinned)
#   OPENDUET_MCP_EGRESS_PORT           the plugin proxy's port inside the service (8789)
#   OPENDUET_MCP_IDLE_MS               how long a plugin may sit unused (600000)
#   OPENDUET_RUNTIME_START_TIMEOUT_MS  how long an attempt may take to start (120000)
#   OPENDUET_ENGINE_PREWARM            engines kept loaded ahead of the next attempts (1; 0 for none)
#   OPENDUET_ATTEMPT_CONCURRENCY       attempts that run at once; more wait for a free slot (4)
#   OPENDUET_NETWORK_POOL              the range each attempt's, computer's and plugin's network takes
#                                    a /28 of; off for Docker's own pools (10.215.0.0/16). Pick one
#                                    nothing the host or service reaches uses (database, VPN, LAN):
#                                    the service joins these networks, so it would send that
#                                    traffic to them instead
# ---------------------------------------------------------------------------

OPENDUET_MCP_NODE_IMAGE=
OPENDUET_MCP_PYTHON_IMAGE=
OPENDUET_MCP_EGRESS_PORT=
OPENDUET_MCP_IDLE_MS=
OPENDUET_RUNTIME_START_TIMEOUT_MS=
OPENDUET_ENGINE_PREWARM=
OPENDUET_ATTEMPT_CONCURRENCY=
OPENDUET_NETWORK_POOL=

# ---------------------------------------------------------------------------
# Browser worker
#
# Read only by deploy/docker-compose.browser.yml, which adds the sandboxed
# browser the agent fills web forms in. Once your account exists,
# bun run openduet browser enable writes both, with the connection entry and the
# space directory the worker needs (docs/browser-worker.md).
#   OPENDUET_BROWSER_SPACE  the id of the space the browser works for
#   OPENDUET_BROWSER_TOKEN  a shared secret of at least 32 characters:
#                         openssl rand -hex 32
# ---------------------------------------------------------------------------

# OPENDUET_BROWSER_SPACE=
# OPENDUET_BROWSER_TOKEN=

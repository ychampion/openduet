{
  "name": "openduet",
  "version": "0.3.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "1.4.2",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "yaml": "2.8.3"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "brace-expansion": "2.1.7",
    "esbuild": "0.28.2",
    "fast-uri": "3.1.9",
    "hono": "4.13.13",
    "ip-address": "10.7.4",
    "undici": "7.30.1"
  },
  "description": "An open-source, self-hosted, model-agnostic personal assistant.",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.13"
  },
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc -b && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "biome check . && bun run scrub:check && bun run names:check && bun run brand:check",
    "scrub:check": "bun run scripts/scrub-check.ts",
    "names:check": "bun run scripts/visible-name-check.ts",
    "release:check": "OPENDUET_RELEASE=1 bun run lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun run scripts/test.ts",
    "doctor": "bun run apps/openduet/test/helpers/preflight.ts",
    "openduet": "bun packages/cli/src/main.ts",
    "test:plugin": "uv run --isolated --no-project --python 3.12 --with pytest==9.1.1 --with aiohttp==3.14.3 --with pillow==12.3.0 python -m pytest packages/runtime-hermes/tests -q",
    "openapi": "bun run packages/contracts/scripts/openapi.ts",
    "compose:check": "bun run deploy/scripts/compose-check.ts",
    "browser:compose:check": "bun run deploy/scripts/browser-compose-check.ts",
    "tailscale:compose:check": "bun run deploy/scripts/tailscale-compose-check.ts",
    "conformance": "bun run conformance/run.ts",
    "conformance:memory": "bun run conformance/memory/run.ts",
    "conformance:memory:eval": "bun run conformance/memory/eval.ts",
    "knowledge:lint": "bun run packages/knowledge/src/cli/lint.ts",
    "db:generate": "bun run --cwd apps/openduet db:generate",
    "client:generate": "bun run packages/client/scripts/generate.ts",
    "dev:mock": "bun run --cwd apps/mock-api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "sample": "bun --no-env-file run scripts/sample.ts",
    "evals": "bun run evals/run.ts",
    "companies:demo": "bun run apps/openduet/src/companies/demo.ts",
    "feedback": "bun run apps/openduet/src/feedback/cli.ts",
    "reset-password": "bun run apps/openduet/src/account/reset-password.ts",
    "brand:check": "bun run scripts/brand-check.ts",
    "icons": "node scripts/build-icons.mjs"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "conformance",
    "evals"
  ]
}
